package bildUP.Arrays;

import java.util.Arrays;

public class BinarySearch {

	public static void main(String[] args) {
		int a[]= {1,3,4,32,5,24,234};
		Arrays.sort(a);
		binSearch(a, 5);
	}

	private static void binSearch(int[] a, int i) {
		int st =0;
		int end=a.length;
		while(st<=end) {
			int mid=st+end/2;
			if(a[mid]==i) {
				System.out.println(mid);
				break;
			}else if(a[mid]>i) {
				end=mid;
				
			}else {
				st=mid+1;
			}
		}
		
	}

}
