package bildUP.Arrays;

import java.util.Arrays;

public class FindIntersectionofTwoArrays {

	public static void main(String[] args) {
		int a[]= {1,2,21,4,41,25};
		int b[]= {2,4,56,7,25};
		
		inter1(a,b);

	}

	private static void inter1(int[] a, int[] b) {
		for(int A:a) {
			int key =A;
			for(int B:b) {
				if(B==key) {
					System.out.print(B+" ");
					break;
				}
			}
		}
		
		
	}

}
